# Public Supabase settings. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Used by the score sync cron and by /api/cron/sync.
CRON_SECRET=

# Public site origin, used in password-reset links.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:43123

# true forces the local sample league even if Supabase is configured.
# false requires Supabase. Leave unset to use Supabase when the keys above exist.
DEMO_MODE=
